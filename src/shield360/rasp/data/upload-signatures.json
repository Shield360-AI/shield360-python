{
  "version": "2026-11-20",
  "comment": "Shield360 built-in web-shell signatures (sdk/rasp/README.md \"Uploads\", \"Signatures\"). Written for Shield360; not derived from any third-party rule set. Every SDK keeps a byte-identical copy.",
  "rules": [
    {
      "id": "php.eval_request",
      "title": "PHP code that evaluates request data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "f0",
          "regex": "eval\\s*\\(\\s*@?\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "eval"
        },
        {
          "id": "f1",
          "regex": "assert\\s*\\(\\s*@?\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "assert"
        }
      ],
      "condition": "open and (f0 or f1)"
    },
    {
      "id": "php.exec_request",
      "title": "PHP code that runs shell commands from request data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "f0",
          "regex": "system\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "system"
        },
        {
          "id": "f1",
          "regex": "exec\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "exec"
        },
        {
          "id": "f2",
          "regex": "passthru\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "passthru"
        },
        {
          "id": "f3",
          "regex": "popen\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "popen"
        },
        {
          "id": "f4",
          "regex": "proc_open\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE|SERVER)",
          "anchor": "proc_open"
        }
      ],
      "condition": "open and (f0 or f1 or f2 or f3 or f4)"
    },
    {
      "id": "php.backtick_request",
      "title": "PHP backtick command from request data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "tick",
          "regex": "`\\$_(GET|POST|REQUEST|COOKIE)\\[",
          "anchor": "`$_"
        }
      ],
      "condition": "all"
    },
    {
      "id": "php.eval_decoded",
      "title": "PHP eval of decoded or decompressed data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "eval",
          "text": "eval(",
          "nocase": true
        },
        {
          "id": "b64",
          "text": "base64_decode(",
          "nocase": true
        },
        {
          "id": "inf",
          "text": "gzinflate(",
          "nocase": true
        },
        {
          "id": "unc",
          "text": "gzuncompress(",
          "nocase": true
        },
        {
          "id": "rot",
          "text": "str_rot13(",
          "nocase": true
        }
      ],
      "condition": "open and eval and (b64 or inf or unc or rot)"
    },
    {
      "id": "php.preg_replace_e",
      "title": "PHP preg_replace with the code-running /e modifier",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "pr",
          "regex": "preg_replace\\s*\\(\\s*[\"'][^\"']{1,100}/[a-df-z]{0,5}e[a-z]{0,5}[\"']",
          "anchor": "preg_replace"
        }
      ],
      "condition": "all"
    },
    {
      "id": "php.create_function_request",
      "title": "PHP create_function or callback built from request data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "f0",
          "regex": "create_function\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "create_function"
        },
        {
          "id": "f1",
          "regex": "call_user_func\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "call_user_func"
        },
        {
          "id": "f2",
          "regex": "array_map\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "array_map"
        },
        {
          "id": "f3",
          "regex": "usort\\s*\\([^;]{0,80}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "usort"
        }
      ],
      "condition": "open and (f0 or f1 or f2 or f3)"
    },
    {
      "id": "php.write_request",
      "title": "PHP code that writes request data to a file",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "f0",
          "regex": "file_put_contents\\s*\\([^;]{0,100}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "file_put_contents"
        },
        {
          "id": "f1",
          "regex": "fwrite\\s*\\([^;]{0,100}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "fwrite"
        },
        {
          "id": "f2",
          "regex": "fputs\\s*\\([^;]{0,100}\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "fputs"
        }
      ],
      "condition": "open and (f0 or f1 or f2)"
    },
    {
      "id": "php.variable_function_request",
      "title": "PHP variable function called with request data",
      "strings": [
        {
          "id": "open",
          "text": "<?php",
          "nocase": true
        },
        {
          "id": "f0",
          "regex": "\\$_GET\\s*\\[[^\\]]{1,40}\\]\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "$_GET"
        },
        {
          "id": "f1",
          "regex": "\\$_POST\\s*\\[[^\\]]{1,40}\\]\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "$_POST"
        },
        {
          "id": "f2",
          "regex": "\\$_REQUEST\\s*\\[[^\\]]{1,40}\\]\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "$_REQUEST"
        },
        {
          "id": "f3",
          "regex": "\\$_COOKIE\\s*\\[[^\\]]{1,40}\\]\\s*\\(\\s*\\$_(GET|POST|REQUEST|COOKIE)",
          "anchor": "$_COOKIE"
        }
      ],
      "condition": "open and (f0 or f1 or f2 or f3)"
    },
    {
      "id": "php.one_liner",
      "title": "One-line PHP shell (China Chopper style)",
      "strings": [
        {
          "id": "a",
          "text": "@eval($_post[",
