    {
      "id": "shell.reverse_shell",
      "title": "Reverse shell command",
      "strings": [
        {
          "id": "tcp",
          "regex": "(sh|bash)\\s+-i\\s*>&\\s*/dev/tcp/",
          "anchor": "/dev/tcp/"
        },
        {
          "id": "nc",
          "regex": "nc(at)?[ a-z-]{0,20}-e\\s+/bin/(ba)?sh",
          "anchor": "/bin/"
        },
        {
          "id": "mkfifo",
          "regex": "mkfifo\\s+/tmp/[A-Za-z0-9_.]{1,20}\\s*;\\s*(nc|cat)\\s",
          "anchor": "mkfifo"
        }
      ],
      "condition": "any"
    }
  ]
}
